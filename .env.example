# MetricLens LLM credentials — copy to your dbt project root as `.env`
# (metriclens loads it automatically; keys never go into metriclens.yml).
# Any OpenAI-compatible endpoint works.

METRICLENS_LLM_BASE_URL=https://api.openai.com/v1
METRICLENS_LLM_API_KEY=sk-xxxx
METRICLENS_LLM_MODEL=gpt-4.1-mini
# Optional: cheaper model for per-hop extraction / stronger model for merge & business prose
# METRICLENS_LLM_FAST_MODEL=
# METRICLENS_LLM_QUALITY_MODEL=
# Optional: global request concurrency cap (default 8)
# METRICLENS_LLM_CONCURRENCY=8
