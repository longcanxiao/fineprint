 "technical": {
  "formula": "repurchase_rate = round(count(distinct case when purchase_seq >= 2 then user_id end) * 1.0 / nullif(count(distinct user_id), 0), 6) where purchase_seq = row_number() over (partition by user_id order by pay_time) and pay_status = 'SUCCESS' and order_status in (20,30,40,50,90) and pay_time is not null and is_risk_order = 0 and coalesce(is_test_account, 0) = 0 group by dt(pay_time)",
  "window": "按支付日期 p.dt 分组统计，统计日归属为支付日期（自然日）",
  "special": [
   "按支付日期 p.dt 分组统计每日复购率",
   "复购用户定义为购买序号 >= 2 的去重用户",
   "purchase_seq 使用 row_number() over (partition by user_id order by pay_time) 生成",
   "订单表按 order_id 取 binlog_ts 最新版本去重；用户表按 user_id 取 binlog_ts 最新版本去重；支付流水按 order_id 取 pay_time 最新去重",
   "汇率版本通过 coalesce(pay_time, order_time) 日期匹配 effective_start/end 左连接，不滤波订单",
   "nullif 防除零、*1.0 转浮点、round 保留 6 位小数"
  ],
  "key_filters": [
   {
    "text": "支付状态为成功 pay_status = 'SUCCESS'",
    "layer": "dwd_trade_pay_suc_detail"
   },
   {
    "text": "订单状态在 (20,30,40,50,90) 范围内",
    "layer": "dwd_trade_pay_suc_detail"
   },
   {
    "text": "支付时间非空 pay_time is not null",
    "layer": "dwd_trade_pay_suc_detail"
   },
   {
    "text": "剔除风控订单 is_risk_order = 0",
    "layer": "dwd_trade_order_detail"
   },
   {
    "text": "剔除测试账号 coalesce(is_test_account,0) = 0",
    "layer": "dwd_trade_order_detail"
   }
  ],
  "summary": "复购率统计每个自然日的复购用户占比。分子为支付流水按用户分组经购买序号 row_number 标记后，购买序号≥2 的去重用户数；分母为当天所有支付用户去重数。数据来源于成功支付流水，经多重去重及业务过滤后计算，结果四舍五入保留6位小数。"
 },
 "business": {
  "definition": "复购率=当日支付成功且非风控、非测试订单中，历史第2笔及以上支付用户数除以当日全部支付用户数，按支付日期统计",
  "clauses": [
   {
    "text": "仅统计支付成功的订单",
    "basis": "pay_status = 'SUCCESS'",
    "evidence_ids": [
     "E3"
    ],
    "basis_verified": true
   },
   {
    "text": "订单状态必须属于指定集合（20,30,40,50,90）（待补充业务注释）",
    "basis": "o.order_status IN (20, 30, 40, 50, 90)",
    "evidence_ids": [
     "E2"
    ],
    "basis_verified": true
   },
   {
    "text": "支付时间非空（即支付成功时间存在）",
    "basis": "NOT o.pay_time IS NULL",
    "evidence_ids": [
     "E1"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除风控订单（风控系统拦截的可疑订单）",
    "basis": "o.is_risk_order = 0",
    "evidence_ids": [
     "E6"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除测试账号产生的订单",
    "basis": "COALESCE(u.is_test_account, 0) = 0",
    "evidence_ids": [
     "E5"
    ],
    "basis_verified": true
   },
   {
    "text": "支付流水按订单ID取支付时间最新的记录，避免重复计数",
    "basis": "ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY pay_time DESC) = 1",
    "evidence_ids": [
     "E4"
    ],
    "basis_verified": true
   },
   {
    "text": "订单明细按订单ID取最新版本记录（多版本快照取最新）",
    "basis": "ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY binlog_ts DESC) = 1",
    "evidence_ids": [
     "E8"
    ],
    "basis_verified": true
   },
   {
    "text": "用户信息按用户ID取最新版本记录（多版本快照取最新）",
    "basis": "ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY binlog_ts DESC) = 1",
    "evidence_ids": [
     "E9"
    ],
    "basis_verified": true
   },
   {
    "text": "按用户支付成功订单的时间先后生成购买序号（首购=1，复购≥2）",
    "basis": "ROW_NUMBER() OVER (PARTITION BY p.user_id ORDER BY p.pay_time)",
    "evidence_ids": [
     "S2"
    ],
    "basis_verified": true
   },
   {
    "text": "复购用户定义为购买序号≥2的用户",
    "basis": "CASE WHEN p.purchase_seq >= 2 THEN p.user_id END",
    "evidence_ids": [
     "S1"
    ],
    "basis_verified": true
   },
   {
    "text": "复购率 = 当日购买序号≥2的去重用户数 ÷ 当日在全部过滤条件下的去重支付用户数，结果四舍五入保留6位小数",
    "basis": "ROUND(COUNT(DISTINCT CASE WHEN \"p\".\"purchase_seq\" >= 2 THEN \"p\".\"user_id\" END) * 1.0 / NULLIF(COUNT(DISTINCT \"p\".\"user_id\"), 0), 6)",
    "evidence_ids": [
     "X2"
    ],
    "basis_verified": true
   }
  ],
  "caveats": [
   "统计日按支付日期（自然日）分组归属，而非订单创建日或退款日；某用户可能在不同日期产生复购，统计归属取决于支付时间（无确定性证据）"
  ]
 },
