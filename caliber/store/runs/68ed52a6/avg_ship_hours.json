     "E6"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除内部测试账号产生的订单。",
    "basis": "COALESCE(u.is_test_account, 0) = 0",
    "evidence_ids": [
     "E2"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除风控系统拦截的订单。",
    "basis": "o.is_risk_order = 0",
    "evidence_ids": [
     "E3"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除揽收时间为空的订单（即无揽收轨迹）。",
    "basis": "NOT pickup_time IS NULL",
    "evidence_ids": [
     "E1"
    ],
    "basis_verified": true
   },
   {
    "text": "揽收时间取自物流轨迹中快递揽收（PICKUP）事件时间。",
    "basis": "CASE WHEN event_type = 'PICKUP' THEN event_time END",
    "evidence_ids": [
