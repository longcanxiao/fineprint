    "basis": "avg_ship_hours = ROUND(AVG(CASE WHEN \"dwd_logistics_ship_detail\".\"is_presale\" = 0 THEN (EPOCH(\"dwd_logistics_ship_detail\".\"pickup_time\") - EPOCH(\"dwd_logistics_ship_detail\".\"pay_time\")) / 3600.0 END), 2)",
