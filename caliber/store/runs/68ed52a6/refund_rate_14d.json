 "business": {
  "definition": "统计日退款成功且支付后14天内退款的金额，除以统计日成功支付金额。",
  "clauses": [
   {
    "text": "分子统计统计日退款成功且支付至退款成功不超过14天的退款金额。",
    "basis": "CASE WHEN days_pay_to_refund <= 14 THEN refund_amt ELSE 0 END",
    "evidence_ids": [
     "S1",
     "S2",
     "X3",
     "X5"
    ],
    "basis_verified": true
   },
   {
    "text": "退款金额优先取退款成功打款金额，缺失时回退申请退款金额，并换算为元。",
    "basis": "refund_amt = COALESCE(\"rp\".\"refund_suc_amt_cent\", \"ra\".\"refund_apply_amt_cent\") / 100.0",
    "evidence_ids": [
     "S4",
     "X4"
    ],
    "basis_verified": true
   },
   {
    "text": "仅统计退款状态为已退款（REFUNDED）的退款记录。",
    "basis": "refund_status = 'REFUNDED'",
    "evidence_ids": [
     "E1",
     "Q1"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除退款成功时间为空的退款记录。",
    "basis": "NOT refund_suc_time IS NULL",
    "evidence_ids": [
     "E2",
     "Q2"
    ],
    "basis_verified": true
   },
   {
    "text": "仅统计订单状态为20、30、40、50、90的订单关联的退款。",
    "basis": "o.order_status IN (20, 30, 40, 50, 90)",
    "evidence_ids": [
     "E3",
     "Q4",
     "Q13"
    ],
    "basis_verified": true
   },
   {
    "text": "同一退款单存在多条记录时，仅保留最新同步版本。",
    "basis": "ROW_NUMBER() OVER (PARTITION BY refund_id ORDER BY binlog_ts DESC) = 1",
    "evidence_ids": [
     "E4",
     "Q3",
     "S3"
    ],
    "basis_verified": true
   },
   {
    "text": "同一交易订单存在多条记录时，仅保留最新同步版本。",
    "basis": "ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY binlog_ts DESC) = 1",
    "evidence_ids": [
     "E8",
     "Q5",
     "S5"
    ],
    "basis_verified": true
   },
   {
    "text": "同一用户存在多条记录时，仅保留最新同步版本，用于维度关联。",
    "basis": "ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY binlog_ts DESC) = 1",
    "evidence_ids": [
     "E9",
     "Q6"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除内部测试账号产生的订单。",
    "basis": "COALESCE(u.is_test_account, 0) = 0",
    "evidence_ids": [
     "E5",
     "Q8"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除风控系统拦截的订单。",
    "basis": "o.is_risk_order = 0",
    "evidence_ids": [
     "E6",
     "Q9"
    ],
    "basis_verified": true
   },
   {
    "text": "仅统计订单支付时间在关联关系有效期间内的记录。",
    "basis": "CAST(COALESCE(o.pay_time, o.order_time) AS DATE) BETWEEN r.effective_start AND r.effective_end",
    "evidence_ids": [
     "E7",
     "Q7"
    ],
    "basis_verified": true
   },
   {
    "text": "分母仅统计支付状态为成功的支付金额。",
    "basis": "pay_status = 'SUCCESS'",
    "evidence_ids": [
     "E11",
     "Q10"
    ],
    "basis_verified": true
   },
   {
    "text": "剔除支付时间为空的记录。",
    "basis": "NOT o.pay_time IS NULL",
    "evidence_ids": [
     "E10",
     "Q12"
    ],
    "basis_verified": true
   },
   {
    "text": "同一订单有多笔支付流水时，仅保留最新支付记录。",
    "basis": "ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY pay_time DESC) = 1",
    "evidence_ids": [
     "E12",
     "Q11",
     "S6"
    ],
    "basis_verified": true
   },
   {
    "text": "分母支付金额以支付流水金额分转元后汇总。",
    "basis": "pay_amt = \"p\".\"pay_amt_cent\" / 100.0",
    "evidence_ids": [
     "X7",
     "X8",
     "X9"
    ],
    "basis_verified": true
   },
   {
    "text": "退款率 = 分子 / 分母，结果保留6位小数，分母为0时避免除零错误。",
    "basis": "refund_rate_14d = ROUND(\"a\".\"refund_amt_14d\" / NULLIF(\"t\".\"pay_amt\", 0), 6)",
    "evidence_ids": [
     "X1"
    ],
    "basis_verified": true
   }
  ],
  "caveats": [
   "分子按退款成功日归属，分母按支付日归属，可能导致比率波动不代表同期退款质量。(无确定性证据)"
  ]
