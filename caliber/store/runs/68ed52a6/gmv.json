 "technical": {
  "formula": "SUM(CASE WHEN NOT EXISTS (SELECT 1 FROM ods_refund_apply ra WHERE ra.order_id = p.order_id AND datediff('second', p.pay_time, ra.apply_time) <= 60 AND ra.binlog_ts = (SELECT MAX(binlog_ts) FROM ods_refund_apply ra2 WHERE ra2.refund_id = ra.refund_id)) THEN ROUND(o.order_amt * r.rate_to_cny, 2) ELSE 0 END) WHERE p.pay_status='SUCCESS' AND p.pay_time IS NOT NULL AND o.order_status IN (20,30,40,50,90) AND coalesce(u.is_test_account,0)=0 AND o.is_risk_order=0 AND cast(coalesce(o.pay_time,o.order_time) as date) BETWEEN r.effective_start AND r.effective_end AND ROW_NUMBER() OVER (PARTITION BY p.order_id ORDER BY p.pay_time DESC)=1 AND ROW_NUMBER() OVER (PARTITION BY o.order_id ORDER BY o.binlog_ts DESC)=1 AND ROW_NUMBER() OVER (PARTITION BY u.user_id ORDER BY u.binlog_ts DESC)=1",
  "window": "按日聚合",
  "special": [
   "秒退剔除：仅当订单支付后60秒内不存在退款申请时计入GMV；退款申请按refund_id取最新记录",
