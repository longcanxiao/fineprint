 "technical": {
  "formula": "COUNT(DISTINCT o.order_id) FROM dwd_trade_pay_suc_detail p JOIN dwd_trade_order_detail o ON p.order_id = o.order_id JOIN user u ON o.user_id = u.user_id JOIN rate r ON CAST(COALESCE(o.pay_time,o.order_time) AS DATE) BETWEEN r.effective_start AND r.effective_end WHERE p.pay_status = 'SUCCESS' AND p.pay_time IS NOT NULL AND o.order_status IN (20, 30, 40, 50, 90) AND COALESCE(u.is_test_account, 0) = 0 AND o.is_risk_order = 0 QUALIFY ROW_NUMBER() OVER (PARTITION BY p.order_id ORDER BY p.pay_time DESC) = 1 AND ROW_NUMBER() OVER (PARTITION BY o.order_id ORDER BY o.binlog_ts DESC) = 1 AND ROW_NUMBER() OVER (PARTITION BY u.user_id ORDER BY u.binlog_ts DESC) = 1",
  "window": "统计日归属：使用 COALESCE(o.pay_time, o.order_time) 作为统计日（dt），DM 按 dt 分组；无滚动时间窗。",
  "special": [
   "按 dt 分组后对 order_id 去重计数",
   "订单表按 order_id 取 binlog_ts 最新版本",
   "支付流水按 order_id 取 pay_time 最新版本",
   "用户表按 user_id 取 binlog_ts 最新版本"
  ],
