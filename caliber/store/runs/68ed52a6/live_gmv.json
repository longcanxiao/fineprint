 "technical": {
  "formula": "SELECT SUM(CASE WHEN is_flash_refund = 0 THEN order_amt_cny ELSE 0 END) FROM (SELECT p.order_amt_cny, p.pay_time, p.live_room_id, p.channel_id, p.live_end_time, CASE WHEN p.live_room_id IS NOT NULL AND (p.channel_id = 'live' OR p.pay_time <= p.live_end_time + INTERVAL 30 MINUTE) THEN 'live' ELSE p.channel_id END AS attributed_channel, CASE WHEN f.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_flash_refund FROM (SELECT o.order_id, ROUND(o.order_amt * r.rate_to_cny,2) AS order_amt_cny, o.pay_time, CASE WHEN o.live_room_id>0 THEN CAST(o.live_room_id AS BIGINT) END AS live_room_id, o.channel_id, o.live_end_time FROM ods_order_info o JOIN ods_exchange_rate r ON CAST(COALESCE(o.pay_time,o.order_time) AS DATE) BETWEEN r.effective_start AND r.effective_end JOIN user_info u ON o.user_id=u.user_id WHERE o.is_risk_order=0 AND COALESCE(u.is_test_account,0)=0 AND o.pay_status='SUCCESS' AND o.pay_time IS NOT NULL AND o.order_status IN (20,30,40,50,90)) p LEFT JOIN ods_refund_apply f ON p.order_id=f.order_id AND DATEDIFF('second', p.pay_time, f.apply_time)<=60) t WHERE attributed_channel='live'",
  "window": "统计日归属：按支付时间 pay_time 归属；直播归因窗口：支付时间 <= 直播结束时间 + 30 分钟；秒退判定窗口：支付后 60 秒内申请退款",
  "special": [
   "排除闪电退款订单金额（CASE WHEN is_flash_refund=0 THEN order_amt_cny ELSE 0 END）",
   "直播渠道归因判定：live_room_id 非空且 (channel_id='live' 或 pay_time <= live_end_time + 30 分钟)",
   "退款申请表按 refund_id 分区取 binlog_ts 最新一条去重",
   "订单表按 order_id 分区取 binlog_ts 最新一条去重",
   "用户表按 user_id 分区取 binlog_ts 最新一条去重",
   "支付流水按 order_id 分区取 pay_time 最新一条去重",
   "汇率按生效区间匹配，订单金额折算为人民币并保留两位小数",
   "live_room_id > 0 时转换为 bigint，否则置为 NULL"
  ],
