  "summary": "客单价按日统计，分子为支付成功金额（分转元后求和），分母为去重支付用户数。分子分母均基于支付成功且订单状态有效、过滤测试/风控用户、订单和支付流水按最新版本去重后的明细计算。最终结果四舍五入保留两位小数。"
 },
 "business": {
  "definition": "客单价=支付成功金额(元)/去重支付用户数，按支付日归集，保留两位小数。",
  "clauses": [
   {
    "text": "客单价按支付金额除以支付用户数计算，结果四舍五入保留2位小数",
    "basis": "atv = ROUND(\"t\".\"pay_amt\" / NULLIF(\"t\".\"pay_user_cnt\", 0), 2)",
    "evidence_ids": [
     "X1"
    ],
    "basis_verified": true
   },
   {
    "text": "分子支付金额仅统计支付状态为SUCCESS的支付流水",
    "basis": "where pay_status = 'SUCCESS'",
    "evidence_ids": [
     "Q1"
    ],
    "basis_verified": true
   },
   {
    "text": "支付流水需为每笔订单最新的一条支付记录（按支付时间倒序取第一条）",
    "basis": "qualify row_number() over (partition by order_id order by pay_time desc) = 1",
    "evidence_ids": [
     "Q2"
    ],
    "basis_verified": true
   },
   {
    "text": "排除支付时间（pay_time）为空的数据",
    "basis": "where o.pay_time is not null",
    "evidence_ids": [
     "Q3"
    ],
    "basis_verified": true
   },
   {
    "text": "订单状态限定为20、30、40、50、90",
    "basis": "and o.order_status in (20, 30, 40, 50, 90)",
    "evidence_ids": [
     "Q4"
    ],
    "basis_verified": true
   },
   {
    "text": "订单明细取每笔订单的最新版本（按binlog时间倒序取第一条）",
    "basis": "qualify row_number() over (partition by order_id order by binlog_ts desc) = 1",
    "evidence_ids": [
     "Q5"
    ],
    "basis_verified": true
   },
   {
    "text": "订单明细取每个用户的最新版本（每个用户保留其最新一笔订单）",
    "basis": "qualify row_number() over (partition by user_id order by binlog_ts desc) = 1",
    "evidence_ids": [
     "Q6"
    ],
    "basis_verified": true
   },
   {
    "text": "统计日期范围按支付时间（若缺失回退下单时间）落在有效开始与结束日期之间",
    "basis": "cast(coalesce(o.pay_time, o.order_time) as date) between r.effective_start and r.effective_end",
    "evidence_ids": [
     "Q7"
    ],
    "basis_verified": true
   },
   {
    "text": "排除测试账号订单（内部测试账号）",
    "basis": "coalesce(u.is_test_account, 0) = 0",
    "evidence_ids": [
     "Q8"
    ],
    "basis_verified": true
   },
   {
    "text": "排除风控系统拦截的订单",
    "basis": "o.is_risk_order = 0",
    "evidence_ids": [
     "Q9"
    ],
    "basis_verified": true
   },
   {
    "text": "支付金额单位由分转换为元（除以100）",
    "basis": "pay_amt = \"p\".\"pay_amt_cent\" / 100.0",
    "evidence_ids": [
     "X7"
    ],
    "basis_verified": true
   }
  ],
  "caveats": [
   "客单价分母为支付用户数（去重），而非订单数；同一用户多笔订单只计1人（无确定性证据）",
   "统计日按支付日归属，若支付成功时间跨天，订单可能归入实际支付日而非下单日（无确定性证据）"
  ]
 },
